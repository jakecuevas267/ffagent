# ESPN private leagues: copy from browser cookies on fantasy.espn.com (DevTools > Application > Cookies)
ESPN_S2=
ESPN_SWID=
# LLM provider key for the model in ffagent.yaml
ANTHROPIC_API_KEY=
# Live contract tests (pytest -m live): a real Sleeper username with at least one league
FFAGENT_LIVE_SLEEPER_USER=
# Optional expert source: a commercial fantasy data API (v2 JSON rankings/projections/injuries).
# When the key is set, its projections replace the platform defaults for every player it covers;
# otherwise Sleeper/ESPN projections are used. URL is the API base, e.g. https://<host>/public/v2/json/nfl
FANTASY_INFORMATION_SOURCE_URL=
FANTASY_INFORMATION_SOURCE_API_KEY=
